{
  "name": "echo-video-transcoder",
  "version": "0.1.0",
  "description": "跨 Windows / macOS 的视频转码工具（Electron + React + TypeScript）",
  "main": "dist/main/index.js",
  "author": "Video Transcoder",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^30.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  },
  "build": {
    "appId": "com.echo.videotranscoder",
    "productName": "Echo Video Transcoder",
    "icon": "build/icon.png",
    "electronDownload": {
      "mirror": "https://cdn.npmmirror.com/binaries/electron/"
    },
    "files": [
      "dist/**"
    ],
    "extraResources": [
      {
        "from": "ffmpeg/bin",
        "to": "."
      },
      {
        "from": "config.json",
        "to": "."
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    }
  }
}
