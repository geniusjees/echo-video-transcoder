{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "npm install（安装依赖 / 下载 Electron 二进制）",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["install"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      }
    },
    {
      "name": "Electron: 开发 (npm run dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--", "--remote-debugging-port=9222"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "node_modules/electron/**"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      }
    },
    {
      "name": "Electron: 构建 (npm run build)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      }
    },
    {
      "name": "Electron: 打包 (npm run dist)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dist"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      }
    },
    {
      "name": "Electron: 附加渲染进程 (Chrome, 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer",
      "sourceMaps": true,
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Electron: 开发 + 附加渲染进程",
      "configurations": ["Electron: 开发 (npm run dev)", "Electron: 附加渲染进程 (Chrome, 9222)"],
      "stopAll": true
    }
  ]
}
